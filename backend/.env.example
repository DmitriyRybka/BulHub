# Строка подключения к Supabase (Settings -> Database -> Connection string -> URI)
# ВАЖНО: используй "Session pooler" строку (порт 5432) или Direct connection
DATABASE_URL=postgresql://postgres.xxxxx:ТВОЙ_ПАРОЛЬ@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Секрет для подписи JWT — сгенерируй свой: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=замени_меня_на_случайную_строку
JWT_EXPIRE_MINUTES=1440
